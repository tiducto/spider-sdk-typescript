{
  "openapi": "3.1.0",
  "info": {
    "title": "Tiducto Transit API — Stops",
    "version": "5.0",
    "description": "Stop text/geo search — a plain-REST customer surface (key-auth). Companion to routing and realtime; the three share one pack version. Enum-ish fields are bare strings so unrecognized values pass through unchanged."
  },
  "servers": [
    {
      "url": "https://{env-slug}.api.tiducto.eu",
      "description": "Your environment. Replace `{env-slug}` with your environment's slug.",
      "variables": {
        "env-slug": {
          "default": "your-env-slug"
        }
      }
    }
  ],
  "security": [
    {
      "apikey": []
    }
  ],
  "paths": {
    "/stops/search": {
      "post": {
        "summary": "Stop text/geo search.",
        "operationId": "stops_search",
        "x-surface": "stops",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopSearchRequest"
              },
              "example": {
                "q": "central",
                "filter": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search hits.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StopSearchResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid apikey.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "4XX": {
            "description": "Stop-search error (e.g. filtering a non-filterable attribute).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StopSearchError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — the key is not permitted for this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apikey": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey",
        "description": "The raw key in an `apikey` header (not Authorization: Bearer)."
      }
    },
    "schemas": {
      "StopSearchRequest": {
        "type": "object",
        "description": "POST body for /stops/search. `filter` is a stop-search filter expression the client composes (not a modeled shape).",
        "properties": {
          "q": {
            "type": "string"
          },
          "filter": {
            "type": "string"
          }
        },
        "required": [
          "q"
        ]
      },
      "StopSearchResponse": {
        "type": "object",
        "properties": {
          "hits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StopHit"
            }
          },
          "query": {
            "type": "string"
          }
        },
        "required": [
          "hits",
          "query"
        ]
      },
      "StopHit": {
        "type": "object",
        "description": "One indexed stop document. Field names must match the stops_env_{envId} index builder (seed-stops.sh). Admin levels and coordinates are populated only where the deployment enriched them.",
        "properties": {
          "gtfsId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          },
          "country": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "suburb": {
            "type": "string"
          }
        },
        "required": [
          "gtfsId",
          "name"
        ]
      },
      "StopSearchError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "link": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error body: a stable machine-readable `code` and a human-readable `message`.",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  }
}