{
  "openapi": "3.1.0",
  "info": {
    "title": "Tiducto Transit API — Routes",
    "version": "5.0",
    "description": "Route (line) text search — a plain-REST customer surface (key-auth). Companion to routing, stops, and realtime; the pack shares one version. Enum-ish fields are bare strings so unrecognized values pass through unchanged."
  },
  "servers": [
    {
      "url": "https://{env-slug}.api.tiducto.eu",
      "description": "Your environment. Replace `{env-slug}` with your environment's slug.",
      "variables": {
        "env-slug": {
          "default": "your-env-slug"
        }
      }
    }
  ],
  "security": [
    {
      "apikey": []
    }
  ],
  "paths": {
    "/routes/search": {
      "post": {
        "summary": "Route (line) text search.",
        "operationId": "routes_search",
        "x-surface": "routes",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteSearchRequest"
              },
              "example": {
                "q": "4",
                "filter": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search hits.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteSearchResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid apikey.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "4XX": {
            "description": "Route-search error (e.g. filtering a non-filterable attribute).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteSearchError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — the key is not permitted for this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apikey": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey",
        "description": "The raw key in an `apikey` header (not Authorization: Bearer)."
      }
    },
    "schemas": {
      "RouteSearchRequest": {
        "type": "object",
        "description": "POST body for /routes/search — transparently proxied to Meilisearch, so this IS a Meilisearch search body. `filter` and `sort` are Meilisearch expressions the client composes (not modeled shapes); the index is filterable on `routeId`, `mode`, and `agencyName`, and sortable on `tripCount` (default-ranked busier-first).",
        "properties": {
          "q": {
            "type": "string"
          },
          "filter": {
            "type": "string",
            "description": "Meilisearch filter expression. Supports mode equality (e.g. `mode = \"BUS\"`), agency equality (`agencyName = \"DPMB\"`), and by-id lookup (`routeId = \"1:L4\"`). Combine multiple with ` AND `."
          },
          "sort": {
            "type": "array",
            "description": "Meilisearch sort expressions, e.g. [\"tripCount:desc\"]. Results are already default-ranked busier-first.",
            "items": {
              "type": "string"
            }
          },
          "limit": {
            "type": "integer",
            "description": "Max hits to return."
          }
        },
        "required": [
          "q"
        ]
      },
      "RouteSearchResponse": {
        "type": "object",
        "properties": {
          "hits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteHit"
            }
          },
          "query": {
            "type": "string"
          }
        },
        "required": [
          "hits",
          "query"
        ]
      },
      "RouteHit": {
        "type": "object",
        "description": "One indexed route document. Field names must match the routes_env_{envId} index builder. shortName/longName/agencyName are populated only where the deployment supplied them.",
        "properties": {
          "routeId": {
            "type": "string"
          },
          "shortName": {
            "type": "string"
          },
          "longName": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "routeType": {
            "type": "integer"
          },
          "agencyName": {
            "type": "string"
          },
          "tripCount": {
            "type": "integer"
          }
        },
        "required": [
          "routeId",
          "mode",
          "routeType",
          "tripCount"
        ]
      },
      "RouteSearchError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "link": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error body: a stable machine-readable `code` and a human-readable `message`.",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  }
}
