{
  "openapi": "3.1.0",
  "info": {
    "title": "Tiducto Transit API — Realtime",
    "version": "5.0",
    "description": "GTFS-RT live data (vehicles, delays, alerts) — a plain-REST customer surface (poll-based, key-auth). Companion to routing and stops; the three share one pack version. Deliberately poll-only (cacheable, high-fanout) — no streaming/subscription surface, so it is OpenAPI, not AsyncAPI. Enum-ish fields are bare strings so unrecognized producer values pass through unchanged."
  },
  "servers": [
    {
      "url": "https://{env-slug}.api.tiducto.eu",
      "description": "Your environment. Replace `{env-slug}` with your environment's slug.",
      "variables": {
        "env-slug": {
          "default": "your-env-slug"
        }
      }
    }
  ],
  "security": [
    {
      "apikey": []
    }
  ],
  "paths": {
    "/realtime/vehicles": {
      "get": {
        "summary": "Live vehicle positions for the given trips.",
        "operationId": "realtime_vehicles",
        "x-surface": "realtime",
        "parameters": [
          {
            "name": "tripIds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Positions found, plus any missing trip ids and feed freshness.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehiclesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid apikey.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — the key is not permitted for this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/realtime/vehicles/by-trip/{id}": {
      "get": {
        "summary": "Live vehicle for a single trip (404 = none currently reporting, a normal state).",
        "operationId": "realtime_vehicle_by_trip",
        "x-surface": "realtime",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The vehicle (or null) plus feed freshness.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleByTripResponse"
                }
              }
            }
          },
          "404": {
            "description": "No vehicle currently reporting for this trip (normal, not an error)."
          },
          "401": {
            "description": "Missing or invalid apikey.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — the key is not permitted for this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/realtime/delays": {
      "get": {
        "summary": "Live schedule deviation for the given trips.",
        "operationId": "realtime_delays",
        "x-surface": "realtime",
        "parameters": [
          {
            "name": "tripIds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delays found, plus any missing trip ids and feed freshness.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DelaysResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid apikey.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — the key is not permitted for this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/realtime/alerts": {
      "get": {
        "summary": "All active service alerts for the environment.",
        "operationId": "realtime_alerts",
        "x-surface": "realtime",
        "responses": {
          "200": {
            "description": "Active alerts plus feed freshness.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid apikey.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — the key is not permitted for this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apikey": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey",
        "description": "The raw key in an `apikey` header (not Authorization: Bearer)."
      }
    },
    "schemas": {
      "VehiclesResponse": {
        "type": "object",
        "properties": {
          "vehicles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vehicle"
            }
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "feedTimestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Epoch seconds; null when the feed has not reported."
          },
          "staleSeconds": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "VehicleByTripResponse": {
        "type": "object",
        "properties": {
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          },
          "feedTimestamp": {
            "type": "integer",
            "format": "int64"
          },
          "staleSeconds": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Vehicle": {
        "type": "object",
        "description": "A vehicle's live position. GTFS-RT producers populate wildly different subsets, so every field is optional. `currentStatus` and `occupancyStatus` are raw GTFS-RT strings passed through unchanged (no enum — unrecognized producer values must survive).",
        "properties": {
          "tripId": {
            "type": "string"
          },
          "routeId": {
            "type": "string"
          },
          "vehicleId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "bearing": {
            "type": "number"
          },
          "speed": {
            "type": "number"
          },
          "stopId": {
            "type": "string"
          },
          "currentStatus": {
            "type": "string"
          },
          "occupancyStatus": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Epoch seconds."
          }
        }
      },
      "DelaysResponse": {
        "type": "object",
        "properties": {
          "delays": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Delay"
            }
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "feedTimestamp": {
            "type": "integer",
            "format": "int64"
          },
          "staleSeconds": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Delay": {
        "type": "object",
        "description": "Live schedule deviation for a trip. `scheduleRelationship` is a raw GTFS-RT string.",
        "properties": {
          "tripId": {
            "type": "string"
          },
          "routeId": {
            "type": "string"
          },
          "delaySeconds": {
            "type": "integer",
            "format": "int32",
            "description": "Trip-level delay; positive = late."
          },
          "scheduleRelationship": {
            "type": "string"
          },
          "stopTimeUpdates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StopTimeUpdate"
            }
          }
        }
      },
      "StopTimeUpdate": {
        "type": "object",
        "properties": {
          "stopId": {
            "type": "string"
          },
          "stopSequence": {
            "type": "integer",
            "format": "int32"
          },
          "arrivalDelay": {
            "type": "integer",
            "format": "int32"
          },
          "departureDelay": {
            "type": "integer",
            "format": "int32"
          },
          "scheduleRelationship": {
            "type": "string"
          }
        }
      },
      "AlertsResponse": {
        "type": "object",
        "properties": {
          "alerts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Alert"
            }
          },
          "feedTimestamp": {
            "type": "integer",
            "format": "int64"
          },
          "staleSeconds": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Alert": {
        "type": "object",
        "description": "A service alert. Text is already resolved to one language by the gateway. `cause`/`effect`/`severityLevel` are raw GTFS-RT strings.",
        "properties": {
          "id": {
            "type": "string"
          },
          "cause": {
            "type": "string"
          },
          "effect": {
            "type": "string"
          },
          "severityLevel": {
            "type": "string"
          },
          "headerText": {
            "type": "string"
          },
          "descriptionText": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "activePeriods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivePeriod"
            }
          },
          "informedEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InformedEntity"
            }
          }
        }
      },
      "ActivePeriod": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "format": "int64",
            "description": "Epoch seconds."
          },
          "end": {
            "type": "integer",
            "format": "int64",
            "description": "Epoch seconds."
          }
        }
      },
      "InformedEntity": {
        "type": "object",
        "properties": {
          "agencyId": {
            "type": "string"
          },
          "routeId": {
            "type": "string"
          },
          "tripId": {
            "type": "string"
          },
          "stopId": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error body: a stable machine-readable `code` and a human-readable `message`.",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  }
}