{
  "openapi": "3.1.0",
  "info": {
    "title": "Tiducto Transit API — Realtime",
    "version": "0.7",
    "description": "GTFS-RT live data (vehicles, delays, alerts) — a plain-REST customer surface (poll-based, key-auth). Companion to routing and stops; the three share one pack version. Deliberately poll-only (cacheable, high-fanout) — no streaming/subscription surface, so it is OpenAPI, not AsyncAPI. Enum-ish fields are bare strings so unrecognized producer values pass through unchanged."
  },
  "servers": [
    {
      "url": "https://{env-slug}.api.tiducto.eu",
      "description": "Your environment. Replace `{env-slug}` with your environment's slug.",
      "variables": {
        "env-slug": {
          "default": "your-env-slug"
        }
      }
    }
  ],
  "security": [
    {
      "apikey": []
    }
  ],
  "paths": {
    "/realtime/vehicles": {
      "get": {
        "summary": "Live vehicle positions for the given trips.",
        "operationId": "realtime_vehicles",
        "x-surface": "realtime",
        "parameters": [
          {
            "name": "tripIds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Positions found, plus any missing trip ids and feed freshness.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehiclesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid apikey.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — the key is not permitted for this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/realtime/vehicles/by-trip/{id}": {
      "get": {
        "summary": "Live vehicle for a single trip. Always 200 with a freshness envelope; `vehicle` is absent when none is currently reporting (a normal state, never 404).",
        "operationId": "realtime_vehicle_by_trip",
        "x-surface": "realtime",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feed freshness plus the live vehicle, when one is reporting; `vehicle` is absent for a trip with none (a normal state, not an error).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleByTripResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid apikey.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — the key is not permitted for this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/realtime/delays": {
      "post": {
        "summary": "Live schedule deviation, resolved per trip instance (trip_id + service date).\n  Group the trip ids you want by the GTFS serviceDate — ISO-8601 YYYY-MM-DD, the\n  same value each plan leg's serviceDate carries — take it from the plan leg,\n  never from the departure clock time (GTFS times may exceed 24:00). A trip\n  instance the feed doesn't hold comes back in that group's `missing`, not\n  painted with another day's delay.",
        "operationId": "realtime_delays",
        "x-surface": "realtime",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DelaysRequest"
              },
              "example": {
                "queries": [
                  {
                    "serviceDate": "2026-09-22",
                    "tripIds": [
                      "1:39822",
                      "1:39823"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delays grouped by service date, each with its missing trip ids, plus global feed freshness.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DelaysResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid apikey.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — the key is not permitted for this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/realtime/alerts": {
      "get": {
        "summary": "All active service alerts for the environment.",
        "operationId": "realtime_alerts",
        "x-surface": "realtime",
        "responses": {
          "200": {
            "description": "Active alerts plus feed freshness.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid apikey.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — the key is not permitted for this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apikey": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey",
        "description": "The raw key in an `apikey` header (not Authorization: Bearer)."
      }
    },
    "schemas": {
      "VehiclesResponse": {
        "type": "object",
        "properties": {
          "vehicles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vehicle"
            }
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "feedTimestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Epoch seconds; null when the feed has not reported."
          },
          "staleSeconds": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "VehicleByTripResponse": {
        "type": "object",
        "properties": {
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          },
          "feedTimestamp": {
            "type": "integer",
            "format": "int64"
          },
          "staleSeconds": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Vehicle": {
        "type": "object",
        "description": "A vehicle's live position. GTFS-RT producers populate wildly different subsets, so every field is optional. `currentStatus` and `occupancyStatus` are raw GTFS-RT strings passed through unchanged (no enum — unrecognized producer values must survive).",
        "properties": {
          "tripId": {
            "type": "string"
          },
          "routeId": {
            "type": "string"
          },
          "vehicleId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "bearing": {
            "type": "number"
          },
          "speed": {
            "type": "number"
          },
          "stopId": {
            "type": "string"
          },
          "currentStatus": {
            "type": "string"
          },
          "occupancyStatus": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Epoch seconds."
          }
        }
      },
      "DelaysRequest": {
        "type": "object",
        "description": "POST body for `/realtime/delays`. Delays are resolved per trip *instance*: a GTFS-RT TripUpdate is bound to a trip instance by (trip_id, start_date), so trip ids are grouped by the GTFS `serviceDate` they run on. Group ids by date rather than sending flat (tripId, serviceDate) pairs — the cardinality is 1-2 dates x many trips.",
        "properties": {
          "queries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DelayQuery"
            }
          }
        },
        "required": [
          "queries"
        ]
      },
      "DelayQuery": {
        "type": "object",
        "properties": {
          "serviceDate": {
            "type": "string",
            "description": "GTFS service date as ISO-8601 `YYYY-MM-DD` — the same format the plan leg's `serviceDate` carries, so pass it straight through. A service date is not a civil date (times may exceed 24:00), so take it from the plan leg, never derive it from the departure clock time. A non-ISO value is rejected with 400."
          },
          "tripIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "serviceDate",
          "tripIds"
        ]
      },
      "DelaysResponse": {
        "type": "object",
        "description": "Grouped to mirror the request: each result group attributes its delays to one `serviceDate`, so a returned delay is unambiguous. Feed freshness (`feedTimestamp`/`staleSeconds`) is global across the snapshot.",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DelayGroupResult"
            }
          },
          "feedTimestamp": {
            "type": "integer",
            "format": "int64"
          },
          "staleSeconds": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "DelayGroupResult": {
        "type": "object",
        "description": "Delays for one service date. `missing` is per group — a trip id can be missing for one date yet present for another (the midnight overlap), which a single top-level `missing` would lose.",
        "properties": {
          "serviceDate": {
            "type": "string",
            "description": "GTFS service date as ISO-8601 `YYYY-MM-DD`, echoing the request."
          },
          "delays": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Delay"
            }
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Delay": {
        "type": "object",
        "description": "Live schedule deviation for a trip. `scheduleRelationship` is a raw GTFS-RT string.",
        "properties": {
          "tripId": {
            "type": "string"
          },
          "routeId": {
            "type": "string"
          },
          "delaySeconds": {
            "type": "integer",
            "format": "int32",
            "description": "Trip-level delay; positive = late."
          },
          "scheduleRelationship": {
            "type": "string"
          },
          "stopTimeUpdates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StopTimeUpdate"
            }
          }
        }
      },
      "StopTimeUpdate": {
        "type": "object",
        "properties": {
          "stopId": {
            "type": "string"
          },
          "stopSequence": {
            "type": "integer",
            "format": "int32"
          },
          "arrivalDelay": {
            "type": "integer",
            "format": "int32"
          },
          "departureDelay": {
            "type": "integer",
            "format": "int32"
          },
          "scheduleRelationship": {
            "type": "string"
          }
        }
      },
      "AlertsResponse": {
        "type": "object",
        "properties": {
          "alerts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Alert"
            }
          },
          "feedTimestamp": {
            "type": "integer",
            "format": "int64"
          },
          "staleSeconds": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Alert": {
        "type": "object",
        "description": "A service alert. Text is already resolved to one language by the gateway. `cause`/`effect`/`severityLevel` are raw GTFS-RT strings.",
        "properties": {
          "id": {
            "type": "string"
          },
          "cause": {
            "type": "string"
          },
          "effect": {
            "type": "string"
          },
          "severityLevel": {
            "type": "string"
          },
          "headerText": {
            "type": "string"
          },
          "descriptionText": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "activePeriods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivePeriod"
            }
          },
          "informedEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InformedEntity"
            }
          }
        }
      },
      "ActivePeriod": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "format": "int64",
            "description": "Epoch seconds."
          },
          "end": {
            "type": "integer",
            "format": "int64",
            "description": "Epoch seconds."
          }
        }
      },
      "InformedEntity": {
        "type": "object",
        "properties": {
          "agencyId": {
            "type": "string"
          },
          "routeId": {
            "type": "string"
          },
          "tripId": {
            "type": "string"
          },
          "stopId": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error body: a stable machine-readable `code` and a human-readable `message`.",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  }
}